# Copy this file to .env and fill in your real keys.
# .env is gitignored / never committed - keys stay local.

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Cloudflare R2 (S3-compatible object storage for source transcript PDFs)
# Easiest: open your bucket -> Settings -> "S3 API" and copy the Endpoint shown there into R2_ENDPOINT_URL.
# (Alternatively set R2_ACCOUNT_ID instead and the endpoint is built from it.)
R2_ENDPOINT_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=concall-transcripts
